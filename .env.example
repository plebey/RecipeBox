# SQL Server
MSSQL_SA_PASSWORD=YOUR_PASSWORD_HERE
MSSQL_PID=Developer

# RecipeBox database
DB_CONNECTION_STRING=Server=db,1433;Database=RecipeBoxDb;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;

# JWT
JWT_KEY=YOUR_JWT_HERE
JWT_ISSUER=RecipeBox
JWT_AUDIENCE=RecipeBoxClient
JWT_EXPIRES_MINUTES=1440

# ASPNET
ASPNETCORE_ENVIRONMENT=Development